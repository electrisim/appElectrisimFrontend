        <mxCell id="-DPXh-h7QqhF4jSscgDO-126" value="&lt;b style=&quot;font-size:14px&quot;&gt;Primary substation 110/20 kV with radial feeders&lt;/b&gt;&lt;br&gt;110 kV grid (S&quot;k max/min 6000/4000 MVA) and two 40 MVA YNd5 transformers.&lt;br&gt;The 20 kV busbar is split (bus coupler open): T1 feeds section A, T2 feeds section B.&lt;br&gt;Feeders A1 and B1 are urban cable feeders closed into an open ring at the normally-open point;&lt;br&gt;A2 supplies a 6 MW industrial customer; B2 is a rural overhead line to a village and a 5 MW PV park.&lt;br&gt;&lt;br&gt;&lt;b&gt;Try:&lt;/b&gt; Load Flow – PV voltage rise on B2, feeder loading;&lt;br&gt;Short Circuit IEC 60909 – close the bus coupler and compare the 20 kV fault levels;&lt;br&gt;close the NOP and open A1-1 to simulate a cable fault restoration; Contingency Analysis (N-1)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#e8f5e9;strokeColor=#81c784;" vertex="1" parent="-DPXh-h7QqhF4jSscgDO-1">
          <mxGeometry x="1140" y="40" width="640" height="173.5" as="geometry" />
        </mxCell>
      </root>
